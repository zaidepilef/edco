# Copiar a .env y completar con los valores reales.
# El sitio funciona sin estas variables, pero la persistencia y la
# notificación quedarían deshabilitadas (se registra en consola).

# PostgreSQL (requerido para persistir prospectos)
DATABASE_URL=postgres://usuario:password@host:5432/edco

# Notificación por email transaccional (Resend)
RESEND_API_KEY=
NOTIFY_EMAIL=contacto@edco.cl

# Analítica (ver tarea 6.6): se inyecta en el layout cuando esté disponible
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX
