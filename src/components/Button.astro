---
interface Props {
  href: string;
  variant?: "primary" | "accent" | "outline" | "ghost" | "on-dark";
  size?: "sm" | "md" | "lg";
  label: string;
}
const { href, variant = "primary", size = "md", label } = Astro.props;

const variants = {
  primary: "bg-brand-500 text-ink hover:bg-brand-400",
  accent: "bg-brand-500 text-ink hover:bg-brand-400",
  outline: "border-2 border-ink text-ink hover:bg-paper-100",
  ghost: "text-ink hover:bg-paper-100",
  "on-dark":
    "border-2 border-white text-white hover:bg-white/10",
};

const sizes = {
  sm: "px-3 py-1.5 text-sm",
  md: "px-5 py-2.5 text-base",
  lg: "px-6 py-3 text-lg",
};
---

<a
  href={href}
  class={`inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-colors ${variants[variant]} ${sizes[size]}`}
>
  {label}
</a>
