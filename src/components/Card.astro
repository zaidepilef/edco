---
interface Props {
  title: string;
  description: string;
  href?: string;
  cta?: string;
  icon?: string;
}
const { title, description, href, cta, icon = "✓" } = Astro.props;
---

<article class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <span
    class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-brand-700"
    aria-hidden="true"
  >
    {icon}
  </span>
  <h3 class="text-xl font-semibold text-ink">{title}</h3>
  <p class="mt-2 flex-1 text-muted">{description}</p>
  {href && (
    <a
      href={href}
      class="mt-4 inline-flex items-center gap-1 font-semibold text-brand-700 hover:text-brand-600"
    >
      {cta ?? "Conocer más"} <span aria-hidden="true">→</span>
    </a>
  )}
</article>
