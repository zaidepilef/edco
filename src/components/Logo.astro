---
interface Props {
  href?: string;
  size?: "sm" | "md" | "lg";
}
const { href = "/edco/", size = "md" } = Astro.props;

const sizes = {
  sm: "h-8",
  md: "h-10",
  lg: "h-12",
};
---

<a
  href={href}
  class={`inline-flex items-center gap-2 ${sizes[size]}`}
  aria-label="EDCO Gestión Preventiva SpA — Inicio"
>
  <svg
    viewBox="0 0 40 40"
    class="h-full w-auto"
    role="img"
    aria-hidden="true"
  >
    <rect width="40" height="40" rx="9" fill="var(--color-ink)" />
    <path
      d="M20 7l9 3.5v6.2c0 6.3-3.8 11.6-9 13.8-5.2-2.2-9-7.5-9-13.8v-6.2L20 7z"
      fill="none"
      stroke="#ffffff"
      stroke-width="2.4"
    />
    <path
      d="M14.5 20l3.6 3.6 7.4-7.4"
      fill="none"
      stroke="var(--color-brand-500)"
      stroke-width="2.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span class="font-bold tracking-tight text-ink">
    EDCO
    <span class="block text-[0.6em] font-semibold uppercase tracking-wider text-muted">
      Gestión Preventiva
    </span>
  </span>
</a>
