---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}
const { eyebrow, title, description, align = "left" } = Astro.props;
const alignClass = align === "center" ? "text-center mx-auto" : "";
---

<div class={`max-w-2xl ${alignClass}`}>
  {eyebrow && (
    <p class="text-sm font-bold uppercase tracking-widest text-brand-700">
      {eyebrow}
    </p>
  )}
  <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
    {title}
  </h2>
  {description && (
    <p class="mt-3 text-lg text-muted">{description}</p>
  )}
</div>
