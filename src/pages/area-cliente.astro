---
import Base from "../layouts/Base.astro";
---

<Base
  title="Área de Cliente | EDCO Gestión Preventiva"
  description="Área de cliente de EDCO Gestión Preventiva. La plataforma de gestión preventiva estará disponible próximamente."
  canonical="/area-cliente"
>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:py-20">
      <p class="text-sm font-bold uppercase tracking-widest text-accent-400">Área de cliente</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Tu plataforma de gestión preventiva está en camino
      </h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16">
    <div class="rounded-2xl border border-dashed border-brand-300 bg-brand-50 p-10 text-center">
      <p class="text-5xl" aria-hidden="true">🚧</p>
      <h2 class="mt-4 text-2xl font-bold text-brand-900">Próximamente</h2>
      <p class="mx-auto mt-3 max-w-xl text-lg text-slate-600">
        Estamos construyendo la plataforma digital de gestión preventiva de EDCO.
        Muy pronto podrás acceder a tus documentos, plan de prevención y avances
        desde una sola cuenta.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/evalua-tu-empresa"
          class="rounded-lg bg-accent-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-600"
        >
          Evalúa tu Empresa
        </a>
        <a
          href="/"
          class="rounded-lg border-2 border-brand-800 px-6 py-3 font-semibold text-brand-800 transition-colors hover:bg-brand-50"
        >
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</Base>
