---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../lib/site";
---

<Base
  title="Contacto | EDCO Gestión Preventiva SpA"
  description="Contacta a EDCO Gestión Preventiva para consultas sobre prevención de riesgos laborales y el Decreto Supremo N°44. Respondemos de forma inmediata."
>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <p class="text-sm font-bold uppercase tracking-widest text-accent-400">Contacto</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Hablemos de tu empresa
      </h1>
      <p class="mt-6 text-lg text-brand-100">
        Escríbenos por el formulario o directamente. Una persona de EDCO responde
        de forma inmediata.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-brand-900">Datos de contacto</h2>
        <address class="mt-6 space-y-4 not-italic">
          <p class="font-semibold text-brand-900">{site.legalName}</p>
          <p>
            <a class="text-slate-700 hover:text-brand-800" href={`mailto:${site.contact.email}`}>
              {site.contact.email}
            </a>
          </p>
          <p>
            <a class="text-slate-700 hover:text-brand-800" href={`tel:${site.contact.phone}`}>
              {site.contact.phone}
            </a>
          </p>
          <p class="text-slate-600">Cobertura en todo Chile</p>
        </address>

        <div class="mt-8 rounded-2xl bg-brand-50 p-6">
          <h3 class="font-semibold text-brand-900">¿Quieres un diagnóstico?</h3>
          <p class="mt-2 text-slate-600">
            Si tu consulta es sobre el estado de tu empresa frente al DS44, el
            camino más directo es el diagnóstico preventivo.
          </p>
          <a
            href="/evalua-tu-empresa"
            class="mt-4 inline-flex items-center gap-1 font-semibold text-brand-800 hover:text-brand-700"
          >
            Evalúa tu Empresa <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-xl font-bold text-brand-900">Envíanos tu consulta</h2>
        <div class="mt-6">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Base>
