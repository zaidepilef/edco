---
import Base from "../layouts/Base.astro";
import EvaluaForm from "../components/EvaluaForm.astro";
import { site } from "../lib/site";

const steps = [
  { num: "1", title: "Completa tus datos", body: "Solo nombre y un medio de contacto. No te pedimos más." },
  { num: "2", title: "Te contactamos de inmediato", body: "Una persona de EDCO se comunica contigo para conocer tu empresa." },
  { num: "3", title: "Recibes tu diagnóstico", body: "Una evaluación inicial de tu situación frente al DS44 con próximos pasos." },
];
---

<Base
  title="Evalúa tu Empresa | Diagnóstico Preventivo DS44 | EDCO"
  description="Solicita tu diagnóstico preventivo 'Evalúa tu Empresa': una evaluación inicial de tu situación frente al Decreto Supremo N°44. Te contactamos de forma inmediata."
>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <p class="text-sm font-bold uppercase tracking-widest text-accent-400">Diagnóstico preventivo</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Evalúa tu Empresa
      </h1>
      <p class="mt-6 text-lg text-brand-100">
        Una evaluación inicial de la gestión preventiva de tu empresa frente al
        Decreto Supremo N°44. Es el primer paso, y el más importante: saber dónde
        estás antes de planificar a dónde ir.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-brand-900">¿Cómo funciona?</h2>
        <ol class="mt-6 space-y-6">
          {
            steps.map((step) => (
              <li class="flex gap-4">
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-800 font-bold text-white"
                  aria-hidden="true"
                >
                  {step.num}
                </span>
                <div>
                  <h3 class="font-semibold text-brand-900">{step.title}</h3>
                  <p class="mt-1 text-slate-600">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-8 rounded-2xl bg-brand-50 p-6">
          <h3 class="font-semibold text-brand-900">¿Qué obtienes?</h3>
          <p class="mt-2 text-slate-600">
            Una evaluación inicial de tu situación frente a la normativa de SST,
            con recomendaciones priorizadas. Ideal si no sabes por dónde partir.
          </p>
        </div>

        <p class="mt-6 text-sm text-slate-500">
          {site.legalName} · Cobertura en todo Chile · Respuesta inmediata
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-xl font-bold text-brand-900">Solicita tu diagnóstico</h2>
        <p class="mt-1 text-sm text-slate-500">Tarda menos de un minuto.</p>
        <div class="mt-6">
          <EvaluaForm />
        </div>
      </div>
    </div>
  </section>
</Base>
