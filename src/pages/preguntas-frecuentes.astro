---
import Base from "../layouts/Base.astro";
import CtaBanner from "../components/CtaBanner.astro";

const faqs = [
  {
    question: "¿Qué es el Decreto Supremo N°44?",
    answer:
      "Es el nuevo marco regulatorio de la prevención de riesgos laborales en Chile, en el contexto de la Ley N°16.744. Ordena cómo las empresas deben organizar su gestión de Seguridad y Salud en el Trabajo. Ver la explicación completa en nuestra página del DS44.",
    link: "/ds44",
  },
  {
    question: "¿A quién aplica el DS44?",
    answer:
      "Aplica a los empleadores que deben gestionar la prevención de riesgos de sus trabajadores. Lo que exige en concreto depende del tamaño, la actividad y los riesgos de cada empresa.",
  },
  {
    question: "¿Qué es el diagnóstico 'Evalúa tu Empresa'?",
    answer:
      "Es una evaluación inicial de la gestión preventiva de tu empresa frente a la normativa de SST y el DS44. Te entrega un punto de partida con recomendaciones priorizadas.",
    link: "/evalua-tu-empresa",
  },
  {
    question: "¿Cuánto cuesta el diagnóstico?",
    answer:
      "No publicamos tarifas en el sitio. Al solicitar tu diagnóstico te contactamos de forma inmediata para contarte cómo funciona y el valor para tu caso.",
  },
  {
    question: "¿Cuánto demoran en responder?",
    answer:
      "Respondemos de forma inmediata: al enviar el formulario, una persona de EDCO se comunica contigo por teléfono o correo.",
  },
  {
    question: "¿Qué cobertura tienen sus servicios?",
    answer:
      "Atendemos empresas de todo Chile, de todos los tamaños y rubros, en prevención de riesgos laborales.",
  },
  {
    question: "¿Puedo contactarlos directamente?",
    answer:
      "Sí. Puedes escribirnos a nuestro correo, llamarnos o usar el formulario de contacto.",
    link: "/contacto",
  },
];
---

<Base
  title="Preguntas Frecuentes (FAQ) | EDCO Gestión Preventiva"
  description="Respuestas a las preguntas frecuentes sobre el Decreto Supremo N°44, el diagnóstico preventivo y los servicios de EDCO."
>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:py-20">
      <p class="text-sm font-bold uppercase tracking-widest text-accent-400">FAQ</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Preguntas frecuentes
      </h1>
      <p class="mt-6 text-lg text-brand-100">
        Las dudas más comunes sobre el DS44, el diagnóstico y nuestros servicios.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <div class="space-y-3">
      {
        faqs.map((faq) => (
          <details
            class="group rounded-xl border border-slate-200 bg-white p-5"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold text-brand-900">
              {faq.question}
              <span class="text-brand-800 transition-transform group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 text-slate-600">{faq.answer}</p>
            {faq.link && (
              <a href={faq.link} class="mt-2 inline-block font-semibold text-brand-800 hover:underline">
                Saber más →
              </a>
            )}
          </details>
        ))
      }
    </div>
  </section>

  <CtaBanner
    title="¿Tienes otra duda?"
    description="Escríbenos y te respondemos de forma inmediata."
  />
</Base>
