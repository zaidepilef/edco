---
import Base from "../../layouts/Base.astro";

const checklist = [
  {
    category: "Conocimiento de tu empresa",
    items: [
      "¿Conozco los riesgos reales de mi operación y de cada puesto de trabajo?",
      "¿Tengo identificados los peligros que pueden causar accidentes o enfermedades laborales?",
      "¿Sé cuántos trabajadores tengo y en qué actividades se desempeñan?",
    ],
  },
  {
    category: "Gestión preventiva",
    items: [
      "¿Mi empresa tiene una gestión preventiva formalmente organizada?",
      "¿Tengo un plan de prevención documentado y vigente?",
      "¿Existe una persona o entidad responsable de la prevención en mi empresa?",
      "¿Tengo identificadas las obligaciones que me exige la normativa según mi tamaño y rubro?",
    ],
  },
  {
    category: "Registros y evidencia",
    items: [
      "¿Tengo registros de las actividades preventivas que realizo?",
      "¿Puedo demostrar la capacitación en prevención de mis trabajadores?",
      "¿Tengo documentada la evaluación de riesgos y sus controles?",
    ],
  },
  {
    category: "Accidentes y emergencias",
    items: [
      "¿Sé qué hacer frente a un accidente laboral y tengo el protocolo a mano?",
      "¿Tengo definidos los pasos de notificación e investigación de accidentes?",
      "¿Mi empresa está preparada para una fiscalización en materia de SST?",
    ],
  },
];
---

<Base
  title="Checklist de Gestión Preventiva DS44 | Descargable | EDCO"
  description="Checklist descargable para revisar el estado de la gestión preventiva de tu empresa frente al DS44. Imprímelo o guárdalo como PDF."
>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-14">
      <p class="text-sm font-bold uppercase tracking-widest text-accent-400">
        <a href="/recursos" class="hover:underline">Recursos</a>
      </p>
      <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Checklist de gestión preventiva
      </h1>
      <p class="mt-5 text-lg text-brand-100">
        Una guía práctica para revisar dónde está tu empresa frente a la
        prevención de riesgos y el DS44. Marca cada casilla y usa los "no" como
        punto de partida de tu plan.
      </p>
      <p class="mt-3 text-sm text-brand-200">
        Consejo: usa la opción de imprimir de tu navegador para guardarlo como PDF.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12">
    <div class="mb-8 flex items-center justify-between">
      <p class="font-semibold text-brand-900">EDCO Gestión Preventiva SpA</p>
      <button
        onclick="window.print()"
        class="rounded-lg bg-brand-800 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-brand-700"
        type="button"
      >
        Imprimir / Guardar PDF
      </button>
    </div>

    {
      checklist.map((group) => (
        <section class="mb-8">
          <h2 class="border-b-2 border-brand-800 pb-2 text-xl font-bold text-brand-900">
            {group.category}
          </h2>
          <ul class="mt-4 space-y-4">
            {
              group.items.map((item) => (
                <li class="flex items-start gap-3">
                  <input
                    type="checkbox"
                    class="mt-1 h-5 w-5 accent-brand-800"
                    aria-label={item}
                  />
                  <span class="text-slate-700">{item}</span>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    }

    <div class="mt-10 rounded-2xl bg-brand-50 p-6 text-center">
      <p class="text-slate-600">
        ¿Muchos "no"? El diagnóstico preventivo te ordena los próximos pasos.
      </p>
      <a
        href="/evalua-tu-empresa"
        class="mt-4 inline-flex items-center gap-1 font-semibold text-brand-800 hover:text-brand-700"
      >
        Evalúa tu Empresa <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
