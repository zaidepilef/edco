---
import Base from "../../layouts/Base.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Recursos | Blog de Prevención de Riesgos y DS44 | EDCO"
  description="Artículos informativos de EDCO sobre prevención de riesgos laborales, Decreto Supremo N°44 y gestión de seguridad y salud en el trabajo en Chile."
>
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:py-20">
      <p class="text-sm font-bold uppercase tracking-widest text-accent-400">Recursos</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Artículos y recursos de prevención
      </h1>
      <p class="mt-6 text-lg text-brand-100">
        Contenido práctico sobre prevención de riesgos, DS44 y seguridad laboral,
        pensado para quienes gestionan empresas en Chile.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <SectionTitle eyebrow="Blog" title="Últimos recursos" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        posts.map((post) => (
          <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <time class="text-sm text-slate-500">
              {post.data.date.toLocaleDateString("es-CL", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <h2 class="mt-2 text-xl font-semibold text-brand-900">
              <a href={`/recursos/${post.id}`} class="hover:text-brand-700">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 flex-1 text-slate-600">{post.data.summary}</p>
            <a
              href={`/recursos/${post.id}`}
              class="mt-4 inline-flex items-center gap-1 font-semibold text-brand-800 hover:text-brand-700"
            >
              Leer artículo <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-10">
      <a
        href="/recursos/checklist-ds44"
        class="inline-flex items-center gap-1 rounded-lg bg-brand-800 px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Descargar checklist de gestión preventiva <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <CtaBanner
    title="¿Quieres saber cómo está tu empresa?"
    description="El diagnóstico preventivo te dice exactamente por dónde partir."
  />
</Base>
